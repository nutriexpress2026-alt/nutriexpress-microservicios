# Plantilla de configuración del frontend. Copiar como `.env.local`.
#
# Dirección del API Gateway, **terminada en /api**: el frontend no habla con
# los microservicios, solo con el gateway (RNF-ARQ-04). `docker compose up`
# lo publica en el puerto 8080. Viaja al navegador (prefijo NEXT_PUBLIC_):
# aquí nunca va nada secreto.
NEXT_PUBLIC_API_URL="http://localhost:8080/api"
