// Generado a partir de prisma/esquema.sql (fuente de verdad). Con la base levantada,
// `npm run db:pull` lo regenera; no editar a mano.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cargo {
  id_cargo     Int        @id @default(autoincrement())
  nombre       String     @unique @db.VarChar(50)
  salario_base Decimal    @default(0) @db.Decimal(10, 2)
  empleado     empleado[]
}

model cliente {
  id_cliente              Int         @id
  preferencia_alimentaria String?     @db.VarChar(100)
  restriccion_dietetica   String?     @db.VarChar(100)
  usuario                 usuario     @relation(fields: [id_cliente], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_cliente_usuario")
}

model empleado {
  id_empleado         Int                  @id
  fecha_ingreso       DateTime             @default(dbgenerated("CURRENT_DATE")) @db.Date
  id_cargo            Int
  disponible          Boolean              @default(false)
  cargo               cargo                @relation(fields: [id_cargo], references: [id_cargo], onDelete: NoAction, onUpdate: NoAction, map: "fk_empleado_cargo")
  usuario             usuario              @relation(fields: [id_empleado], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_empleado_usuario")
}

model permiso {
  id_permiso  Int           @id @default(autoincrement())
  nombre      String        @unique @db.VarChar(50)
  rol_permiso rol_permiso[]
}

model rol {
  id_rol      Int           @id @default(autoincrement())
  nombre      String        @unique @db.VarChar(50)
  rol_permiso rol_permiso[]
  usuario     usuario[]
}

model rol_permiso {
  id_rol_permiso      Int                   @id @default(autoincrement())
  id_rol              Int
  id_permiso          Int
  permiso             permiso               @relation(fields: [id_permiso], references: [id_permiso], onDelete: NoAction, onUpdate: NoAction, map: "fk_rol_permiso_permiso")
  rol                 rol                   @relation(fields: [id_rol], references: [id_rol], onDelete: NoAction, onUpdate: NoAction, map: "fk_rol_permiso_rol")
  usuario_rol_permiso usuario_rol_permiso[]

  @@unique([id_rol, id_permiso], map: "uq_rol_permiso")
}

model usuario {
  id_usuario              Int                       @id @default(autoincrement())
  nombre                  String                    @db.VarChar(100)
  apellido                String                    @db.VarChar(100)
  email                   String                    @unique @db.VarChar(150)
  telefono                String?                   @db.VarChar(20)
  nombre_usuario          String                    @unique @db.VarChar(50)
  contrasena_hash         String                    @db.VarChar(255)
  intentos_fallidos       Int                       @default(0)
  bloqueado               Boolean                   @default(false)
  fecha_bloqueo           DateTime?                 @db.Timestamp(6)
  activo                  Boolean                   @default(true)
  fecha_registro          DateTime                  @default(now()) @db.Timestamp(6)
  id_rol                  Int
  ultimo_acceso           DateTime?                 @db.Timestamp(6)
  veces_bloqueado         Int                       @default(0)
  cliente                 cliente?
  empleado                empleado?
  recuperacion_contrasena recuperacion_contrasena[]
  rol                     rol                       @relation(fields: [id_rol], references: [id_rol], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario_rol")
  usuario_rol_permiso     usuario_rol_permiso[]
}

model usuario_rol_permiso {
  id_usuario_rol_permiso Int         @id @default(autoincrement())
  id_usuario             Int
  id_rol_permiso         Int
  rol_permiso            rol_permiso @relation(fields: [id_rol_permiso], references: [id_rol_permiso], onDelete: NoAction, onUpdate: NoAction, map: "fk_urp_rol_permiso")
  usuario                usuario     @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_urp_usuario")

  @@unique([id_usuario, id_rol_permiso], map: "uq_usuario_rol_permiso")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model recuperacion_contrasena {
  id_recuperacion Int       @id @default(autoincrement())
  id_usuario      Int
  codigo_hash     String    @db.VarChar(64)
  creado_en       DateTime  @default(now()) @db.Timestamp(6)
  expira_en       DateTime  @db.Timestamp(6)
  intentos        Int       @default(0)
  usado_en        DateTime? @db.Timestamp(6)
  usuario         usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_recuperacion_usuario")

  @@index([id_usuario], map: "ix_recuperacion_usuario")
}
