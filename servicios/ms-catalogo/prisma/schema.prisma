// Generado a partir de prisma/esquema.sql (fuente de verdad). Con la base levantada,
// `npm run db:pull` lo regenera; no editar a mano.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model categoria {
  id_categoria Int        @id @default(autoincrement())
  nombre       String     @unique @db.VarChar(50)
  producto     producto[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model producto {
  id_producto           Int                @id @default(autoincrement())
  nombre                String             @db.VarChar(100)
  descripcion           String?            @db.VarChar(250)
  precio_venta          Decimal            @db.Decimal(10, 2)
  activo                Boolean            @default(true)
  id_categoria          Int
  tipo_conservacion     String             @default("Seco") @db.VarChar(20)
  imagen                Bytes?
  imagen_tipo           String?            @db.VarChar(20)
  imagen_actualizada_en DateTime?          @db.Timestamptz(6)
  categoria             categoria          @relation(fields: [id_categoria], references: [id_categoria], onDelete: NoAction, onUpdate: NoAction, map: "fk_producto_categoria")
  receta                receta[]
  valor_nutricional     valor_nutricional?
}

model valor_nutricional {
  id_producto     Int      @id
  calorias        Int
  proteinas_g     Decimal  @db.Decimal(6, 2)
  carbohidratos_g Decimal  @db.Decimal(6, 2)
  grasas_g        Decimal  @db.Decimal(6, 2)
  fibra_g         Decimal? @db.Decimal(6, 2)
  producto        producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade, onUpdate: NoAction, map: "fk_valnut_producto")
}

model configuracion {
  clave          String   @id @db.VarChar(50)
  valor          String   @db.VarChar(200)
  descripcion    String?  @db.VarChar(200)
  actualizado_en DateTime @default(now()) @db.Timestamp(6)
  id_usuario     Int?

  @@index([id_usuario], map: "ix_config_usuario")
}

model evento_procesado {
  id_evento    String   @id @db.Uuid
  tipo         String   @db.VarChar(60)
  procesado_en DateTime @default(now()) @db.Timestamp(6)
}

model sesion_vigente {
  clave String   @id @db.VarChar(30)
  desde DateTime @db.Timestamp(6)
}

model insumo {
  id_ingrediente Int              @id
  nombre         String           @db.VarChar(100)
  unidad         String           @db.VarChar(10)
  costo_unitario Decimal          @default(0) @db.Decimal(10, 2)
  activo         Boolean          @default(true)
  detalle_receta detalle_receta[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// `db pull` lee el índice parcial ux_receta_activa (una sola activa por producto) como si
/// id_producto fuera único y deja la relación uno a uno; un producto tiene varias versiones,
/// así que aquí va sin @unique. La regla la sigue haciendo cumplir la base (esquema.sql).
model receta {
  id_receta                  Int                @id @default(autoincrement())
  id_producto                Int
  nombre                     String             @db.VarChar(100)
  rendimiento                Int
  tiempo_preparacion_minutos Int                @default(0)
  instrucciones              String?            @db.VarChar(2000)
  divisible                  Boolean            @default(true)
  activa                     Boolean            @default(false)
  creada_en                  DateTime           @default(now()) @db.Timestamp(6)
  detalle_receta             detalle_receta[]
  orden_produccion           orden_produccion[]
  producto                   producto           @relation(fields: [id_producto], references: [id_producto], onDelete: NoAction, onUpdate: NoAction, map: "fk_receta_producto")

  @@index([id_producto], map: "ix_receta_producto")
}

model detalle_receta {
  id_receta          Int
  id_ingrediente     Int
  cantidad_requerida Decimal @db.Decimal(12, 3)
  insumo             insumo  @relation(fields: [id_ingrediente], references: [id_ingrediente], onDelete: NoAction, onUpdate: NoAction, map: "fk_detreceta_insumo")
  receta             receta  @relation(fields: [id_receta], references: [id_receta], onDelete: Cascade, onUpdate: NoAction, map: "fk_detreceta_receta")

  @@id([id_receta, id_ingrediente])
  @@index([id_ingrediente], map: "ix_detreceta_insumo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalle_orden_insumo {
  id_orden_produccion Int
  id_ingrediente      Int
  nombre              String           @db.VarChar(100)
  unidad              String           @db.VarChar(10)
  cantidad            Decimal          @db.Decimal(12, 3)
  costo_unitario      Decimal          @db.Decimal(10, 2)
  orden_produccion    orden_produccion @relation(fields: [id_orden_produccion], references: [id_orden_produccion], onDelete: NoAction, onUpdate: NoAction, map: "fk_detorden_orden")

  @@id([id_orden_produccion, id_ingrediente])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orden_produccion {
  id_orden_produccion  Int                    @id @default(autoincrement())
  fecha                DateTime               @default(now()) @db.Timestamp(6)
  estado               String                 @default("Pendiente") @db.VarChar(12)
  cantidad             Int
  id_receta            Int
  id_empleado          Int
  empleado_nombre      String                 @db.VarChar(201)
  fecha_finalizacion   DateTime?              @db.Timestamp(6)
  cantidad_obtenida    Int?
  costo_total          Decimal?               @db.Decimal(12, 2)
  id_almacen_destino   Int?
  almacen_destino      String?                @db.VarChar(50)
  id_nota_egreso       Int?
  id_nota_ingreso      Int?
  detalle_orden_insumo detalle_orden_insumo[]
  receta               receta                 @relation(fields: [id_receta], references: [id_receta], onDelete: NoAction, onUpdate: NoAction, map: "fk_ordprod_receta")

  @@index([estado], map: "ix_ordprod_estado")
  @@index([fecha(sort: Desc)], map: "ix_ordprod_fecha")
  @@index([id_receta], map: "ix_ordprod_receta")
}
