generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalle_pedido {
  id_pedido       Int
  id_producto     Int
  nombre_producto String  @db.VarChar(100)
  cantidad        Int
  precio_unitario Decimal @db.Decimal(10, 2)
  pedido          pedido  @relation(fields: [id_pedido], references: [id_pedido], onDelete: NoAction, onUpdate: NoAction, map: "fk_detpedido_pedido")

  @@id([id_pedido, id_producto])
}

model evento_procesado {
  id_evento    String   @id @db.Uuid
  tipo         String   @db.VarChar(60)
  procesado_en DateTime @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pedido {
  id_pedido          Int              @id @default(autoincrement())
  fecha              DateTime         @default(now()) @db.Timestamp(6)
  estado_pedido      String           @default("Recibido") @db.VarChar(20)
  estado_pago        String           @default("Pendiente") @db.VarChar(20)
  metodo_pago        String           @db.VarChar(20)
  referencia_pago    String?          @db.VarChar(100)
  total              Decimal          @db.Decimal(12, 2)
  fecha_entrega      DateTime?        @db.Timestamp(6)
  motivo_cancelacion String?          @db.VarChar(20)
  id_usuario         Int
  cliente_nombre     String           @db.VarChar(120)
  id_ubicacion       Int
  id_reserva         String           @unique @db.VarChar(60)
  id_pago            Int?
  id_repartidor      Int?
  repartidor_nombre  String?          @db.VarChar(120)
  detalle_pedido     detalle_pedido[]
  ubicacion          ubicacion        @relation(fields: [id_ubicacion], references: [id_ubicacion], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedido_ubicacion")

  @@index([id_usuario, fecha(sort: Desc)], map: "ix_pedido_usuario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model posicion_repartidor {
  id_empleado    Int      @id
  latitud        Decimal  @db.Decimal(8, 6)
  longitud       Decimal  @db.Decimal(9, 6)
  precision_m    Decimal? @db.Decimal(8, 1)
  actualizada_en DateTime @default(now()) @db.Timestamp(6)
}

model sesion_vigente {
  clave String   @id @db.VarChar(30)
  desde DateTime @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ubicacion {
  id_ubicacion   Int      @id @default(autoincrement())
  id_usuario     Int?     @unique(map: "uq_ubicacion_principal", where: raw("(principal AND vigente)"))
  etiqueta       String?  @db.VarChar(50)
  calle          String   @db.VarChar(150)
  numero         String?  @db.VarChar(20)
  referencia     String?  @db.VarChar(150)
  latitud        Decimal? @db.Decimal(8, 6)
  longitud       Decimal? @db.Decimal(9, 6)
  principal      Boolean  @default(false)
  vigente        Boolean  @default(true)
  fecha_registro DateTime @default(now()) @db.Timestamp(6)
  pedido         pedido[]
}

model turno_repartidor {
  id_empleado    Int      @id
  disponible     Boolean  @default(false)
  actualizado_en DateTime @default(now()) @db.Timestamp(6)
}
