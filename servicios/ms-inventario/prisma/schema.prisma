/// Réplica de ms-identidad: se completa con el token de quien registra.
model empleado {
  id_empleado Int    @id
  nombre      String @db.VarChar(100)
  apellido    String @db.VarChar(100)
  nota_egreso         nota_egreso[]
  nota_ingreso        nota_ingreso[]
}

model ingrediente {
  id_ingrediente       Int                   @id @default(autoincrement())
  nombre               String                @db.VarChar(100)
  stock_minimo         Decimal               @default(0) @db.Decimal(12, 3)
  costo_unitario       Decimal               @default(0) @db.Decimal(10, 2)
  activo               Boolean               @default(true)
  id_unidad            Int
  tipo_conservacion    String                @default("Seco") @db.VarChar(20)
  controla_vencimiento Boolean               @default(false)
  unidad_medida        unidad_medida         @relation(fields: [id_unidad], references: [id_unidad], onDelete: NoAction, onUpdate: NoAction, map: "fk_ingrediente_unidad")
  ingrediente_almacen  ingrediente_almacen[]
  lote                 lote[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
