// Generado a partir de prisma/esquema.sql (fuente de verdad). Con la base levantada,
// `npm run db:pull` lo regenera; no editar a mano.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model almacen {
  id_almacen          Int                   @id @default(autoincrement())
  nombre              String                @unique @db.VarChar(50)
  tipo_conservacion   String                @unique(map: "ux_almacen_preferido", where: raw("preferido")) @db.VarChar(20)
  ubicacion_fisica    String?               @db.VarChar(150)
  preferido           Boolean               @default(false)
  ingrediente_almacen ingrediente_almacen[]
  lote_almacen        lote_almacen[]
  producto_almacen    producto_almacen[]
}

